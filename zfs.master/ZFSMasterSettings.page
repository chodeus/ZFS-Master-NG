require_once "$docroot/plugins/$plugin/include/ZFSMReplicaRemote.php";
require_once "$docroot/plugins/$plugin/include/ZFSMSchedule.php";

$zfsm_saved = parse_plugin_cfg($plugin, true);
$zfsm_cfg = loadConfig($zfsm_saved);
// Keep Replicas' field shows what applies (empty: all), so a saved value it can't read never holds up Apply; the warning names it.
$zfsm_keep_warning = zfsmKeepReplicaWarning((string)($zfsm_saved['general']['replica_keep'] ?? ''));
$zfsm_name_warning = zfsmNewSnapshotNamesWhy($zfsm_cfg, time(), true);
$zfsm_snapsched = zfsmScheduleShown();
$zfsm_copysched = zfsmScheduleShown('zfsmScheduleCopiesUnder');
$zfsm_version = zfsmPluginVersion("/var/log/plugins/$plugin.plg");

?>
   
