		if (!answer.error) zfsmSendServersShown(answer);
	});
}
// Every Dataset's Saves, Remove and Change Keep, one at a time as each answer redraws the list: all their buttons are off until it lands.
function zfsmSchedulesSend(data, done) {
	var buttons = $('#zfsm-snapsched-save, #zfsm-copysched-save, #zfsm-schedules input[type=button]').prop('disabled', true);
	zfsmSendPost(data, function(answer) {
		buttons.prop('disabled', false);
		done(answer);
		if (answer.schedules_html !== undefined) $('#zfsm-schedules').html(answer.schedules_html);
	});
}
// Remove and Change Keep: why not, under the list.
