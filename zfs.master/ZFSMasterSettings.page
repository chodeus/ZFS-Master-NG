<script>
var zfsm_tips = <?=zfsmJson(array(
	'refresh_interval' => _('How often the Main tab reloads pool and dataset details.'),
	'lazy_load' => _('Show datasets first, then load snapshots one pool at a time.'),
	'znapzend_data' => _('Show ZnapZend backup plans on each dataset.'),
	'size_units' => _('Show sizes in ZFS units (GiB) or Unraid units (GB).'),
	'destructive_mode' => _('Show rename, edit and destroy, and allow deletes of folders and newer snapshots.'),
	'debug_log' => _('Also write the commands the plugin runs, and the requests it gets, to a debug log.'),
	'exclusion' => _('Hide datasets and listed folders whose names match this pattern.'),
	'directory_listing' => _('Datasets whose folders are listed on the Main tab, one per line.'),
	'snap_max_days_alert' => _('Days since the last snapshot before the camera icon turns orange.'),
	'snap_pattern' => _('Date format for new snapshot names, using PHP date() letters.'),
	'snap_prefix' => _('Text placed before the date in new snapshot names.'),
	'snap_utc' => _('Clock used for the date in new snapshot names.'),
	'alert_interval' => _('How often to check pool health and send Unraid notifications.'),
	'alert_stale' => _('Also notify when snapshots are older than the Max Days setting.'),
	'replica_accept' => _('An existing dataset other servers may send copies into. Empty turns this off.'),
	'replica_keep' => _('Which snapshots of each copy received here stay: a number keeps the newest that many; 7d, 4w and 12m the newest of each of the last 7 days, 4 weeks and 12 months that have one. Empty keeps all.'),
), JSON_HEX_TAG | JSON_HEX_AMP)?>;
$('details.zfsm-section dl').each(function() {
	var name = $(this).find('[name]').attr('name');
	if (zfsm_tips[name]) $(this).children('dt').addClass('zfsm-tip').attr({'data-tip': zfsm_tips[name], tabindex: 0});
});
$('textarea[name="exclusion"]').on('change', function() {
	$.post('/plugins/zfs.master/backend/ZFSMAdmin.php', {cmd: 'validateexclusion', pattern: $(this).val()}, function(answer) {
		$('#zfsm-exclusion-warning').text(answer.valid ? '' : 'This pattern is invalid and would be ignored.');
	}, 'json');
});
// Outside the form, so its tick box never arms Apply. A run already going, or the last zip, shows on load.
var zfsm_diagnostics = createZFSMDiagnostics({url: '/plugins/zfs.master/backend/ZFSMAdmin.php', download: '/plugins/zfs.master/backend/ZFSMDiagDownload.php?file=',
	button: $('#zfsm-diag-start'), box: $('#zfsm-diag-unraid'), status: $('#zfsm-diag-status'), link: $('#zfsm-diag-link'), report: function() { return zfsmDiagReport(window); }});
$('#zfsm-diag-start').on('click', zfsm_diagnostics.start);
zfsm_diagnostics.poll();
window.addEventListener('pagehide', zfsm_diagnostics.stop);
// A page brought back from the browser's cache asks again: what it showed was stopped when it was left.
window.addEventListener('pageshow', function(event) { if (event.persisted) zfsm_diagnostics.poll(); });

// Replicate To Other Servers: each answer carries what its action gives (the refreshed HTML, a host key and its fingerprint,
// or the area a test found) or, as error, why not. Unraid's page adds the token to every post ($.ajaxPrefilter, DefaultPageLayout.php).
var zfsm_send_found = null;
var zfsm_send_asked = 0;
function zfsmSendPost(data, done) {
	$.post('/plugins/zfs.master/backend/ZFSMAdmin.php', data, function(answer) {
		answer = answer || {};
		// ZFSMAdmin's catch-all answers {failed: {request: why}}, with no error.
		if (!answer.error && answer.failed) answer = {error: Object.values(answer.failed)[0] || 'The request failed'};
		done(answer);
	}, 'json').fail(function() { done({error: 'No answer from this server'}); });
}
function zfsmSendKey() {
	// Off while it runs: a second click would answer "already has its key" beside the new key.
	var button = $('#zfsm-send-key input[type=button]').prop('disabled', true);
	zfsmSendPost({cmd: 'replicakey'}, function(answer) {
		$('#zfsm-send-key-status').text(answer.error || '');
		if (answer.error) return button.prop('disabled', false);
		$('#zfsm-send-key').html(answer.key_html);
		$('#zfsm-send-servers').html(answer.servers_html);
	});
}
// After an Add or Remove: the list, and Server's options (all but This server), which keep what it has chosen.
function zfsmSendServersShown(answer) {
	$('#zfsm-send-servers').html(answer.servers_html);
	var server = $('#zfsm-copysched-server');
	server.children().slice(1).remove();
	server.append(answer.server_options);
}
function zfsmSendScan() {
	var asked = {host: $('#zfsm-send-host').val(), port: $('#zfsm-send-port').val()};
	var found = $('#zfsm-send-found').css('color', '').text('Reading…');
	var ask = ++zfsm_send_asked;
	zfsm_send_found = null;
	zfsmSendPost($.extend({cmd: 'replicascan'}, asked), function(answer) {
		// An answer for an address or port changed since is dropped.
		if (ask !== zfsm_send_asked) return;
		if (answer.error) return found.css('color', '#e22828').text(answer.error);
		zfsm_send_found = $.extend(asked, {key: answer.key, fingerprint: answer.fingerprint});
		var add = $('<input type="button" value="Add" disabled>').on('click', zfsmSendAdd);
		var match = $('<input type="checkbox">').on('change', function() { add.prop('disabled', !this.checked); });
		found.empty().append(document.createTextNode('Host key '+answer.fingerprint+' '), $('<label>').append(match, ' matches that server\'s Settings'), ' ', add);
	});
}
// A changed address or port needs its own host key read again.
$('#zfsm-send-host, #zfsm-send-port').on('input', function() { zfsm_send_asked++; zfsm_send_found = null; $('#zfsm-send-found').empty(); });
function zfsmSendAdd() {
	if (!zfsm_send_found) return;
	var ask = zfsm_send_asked;
	var found = $('#zfsm-send-found');
	found.children('.zfsm-send-refused').remove();
	// Off while it runs: a second click would answer "already a server here" for an Add that worked.
	var controls = found.find('input').prop('disabled', true);
	zfsmSendPost($.extend({cmd: 'replicaadd', name: $('#zfsm-send-name').val(), server: $('#zfsm-copysched-server').val()}, zfsm_send_found), function(answer) {
		if (!answer.error) zfsmSendServersShown(answer);
		// A host key read since keeps its fields and its Add.
		if (ask !== zfsm_send_asked) return;
		if (answer.error) {
			// Add and its ticked box come back: a name put right is added without reading the host key again.
			controls.prop('disabled', false);
			return found.append($('<span class="zfsm-send-refused" style="color:#e22828">').text(' '+answer.error));
		}
		zfsm_send_found = null;
		found.empty();
		$('#zfsm-send-name, #zfsm-send-host').val('');
	});
}
function zfsmSendRemove(name) {
	zfsmSendPost({cmd: 'replicaremove', name: name, server: $('#zfsm-copysched-server').val()}, function(answer) {
		$('#zfsm-send-servers-status').text(answer.error || '');
		if (!answer.error) zfsmSendServersShown(answer);
	});
}
// Every Dataset's Saves, Remove and Change Keep, one at a time as each answer redraws the list: all their buttons are off until it lands.
function zfsmSchedulesSend(data, done) {
	var pressed = document.activeElement, buttons = $('#zfsm-snapsched-save, #zfsm-copysched-save, #zfsm-schedules input[type=button]').prop('disabled', true);
	zfsmSendPost(data, function(answer) {
		buttons.prop('disabled', false);
		if (answer.schedules_html !== undefined) $('#zfsm-schedules').html(answer.schedules_html);
		// A browser may take focus from a button it turns off: the one pressed gets it back while it is still there and focus didn't move.
		if (document.activeElement === document.body && buttons.is(pressed)) pressed.focus();
		done(answer);
	});
}
// Remove: why not, under the list. Focus a redraw drops from a row goes to the last button (its Remove where it has one) of the row now
// in that place, else of the last row, if that has any.
function zfsmScheduleRemove(id) {
	var rows = function() { return $('#zfsm-schedules tbody'); };
	var at = rows().index($(document.activeElement).closest('#zfsm-schedules tbody'));
	zfsmSchedulesSend({cmd: 'scheduleremove', id: id}, function(answer) {
		$('#zfsm-schedules-status').text(answer.error || '');
		if (at >= 0 && document.activeElement === document.body) rows().eq(Math.min(at, rows().length - 1)).find('input[type=button]').last().trigger('focus');
	});
}
// Change Keep of a repeat set in Replicate, from its button's data (zfsmScheduleKeepButton); one on another server has no Copy Keeps.
// Open until its answer lands; a refusal shows in it, with what was typed; one saved whose crontab was not rebuilt says so under the list.
function zfsmScheduleKeepDialog(button) {
	var data = button.dataset, esc = zfsmEscape, copies = 'copyKeeps' in data;
	var idle = function() { return !Swal2.isLoading(); };
	zfsmFormDialog({
		title: '<strong>Change Keep<br>' + esc(data.dataset) + '</strong>',
		html: '<p style="margin:.2em 0 .8em">Copied to ' + esc(data.to) + ', ' + esc(data.when) + '.</p>' + zfsmKeepRowsHtml('zfsm-change', data.keep, data.copyKeeps, copies),
		showCancelButton: true, confirmButtonText: 'Save', focusConfirm: false, showLoaderOnConfirm: true, allowEscapeKey: idle, allowOutsideClick: idle,
		preConfirm: function() {
			var field = function(id) { return Swal2.getPopup().querySelector('#zfsm-change-' + id).value; };
			var sent = {cmd: 'schedulekeepchange', id: data.id, keep: field('keep'), copy_keeps: copies ? field('copy-keeps') : ''};
			return new Promise(function(resolve) {
				zfsmSchedulesSend(sent, function(answer) {
					if (answer.schedules_html !== undefined) return resolve(answer);
					Swal2.showValidationMessage(esc(answer.error || 'The request failed'));
					resolve(false);
				});
			});
		},
		// Focus goes back to the button, or after a save, whose redraw drops it, to its row's new one, which the library can't find.
		returnFocus: false,
		didClose: function() {
			$(button.isConnected ? button : $('#zfsm-schedules input[type=button]').filter(function() { return this.dataset.id === data.id; })).trigger('focus');
		}
	}).then(function(result) {
		if (result.isConfirmed) $('#zfsm-schedules-status').text(result.value.error || '');
	});
}
// Snapshot and Replicate Every Dataset, by their rows' id prefix: Days and Starts At for days of the week, Cron Line for Custom (cron),
// the rest for any repeat.
function zfsmEverySync(prefix) {
	var every = $('#' + prefix + '-every').val();
	// Not .toggle(): jQuery 2 (Unraid 6.9) writes display:block over the theme's own display.
	var show = function(id, shown) { var dd = $(id).closest('dd'); dd.add(dd.prev('dt')).css('display', shown ? '' : 'none'); };
	show('#' + prefix + '-days', every === 'days');
	show('#' + prefix + '-time', every === 'days');
	show('#' + prefix + '-cron', every === 'cron');
	show('#' + prefix + '-keep', every !== 'off');
	show('#' + prefix + '-leave-out', every !== 'off');
	show('#' + prefix + '-copy-keeps', every !== 'off' && !$('#' + prefix + '-server').val());
	show('#' + prefix + '-server', every !== 'off');
	show('#' + prefix + '-under', every !== 'off');
	// A help goes with the row Unraid binds it to, the last of the list before it; a class, as Help's .show() writes display (zfsm-forms.css).
	$('#' + prefix + '-every').closest('details').find('blockquote.inline_help').each(function() {
		$(this).toggleClass('zfsm-row-off', $(this).prevAll('dl').first().children('dd').last().css('display') === 'none');
	});
}
function zfsmEverySave(prefix, cmd) {
	var status = $('#' + prefix + '-status').css('color', '').text('Saving…');
	var days = $('.' + prefix + '-day:checked').map(function() { return this.value; }).get().join(',');
	var every = $('#' + prefix + '-every').val();
	var post = {cmd: cmd, every: every, time: $('#' + prefix + (every === 'cron' ? '-cron' : '-time')).val(), days: days, keep: $('#' + prefix + '-keep').val()};
	var under = $('#' + prefix + '-under');
	if (under.length) post.under = under.val();
	var server = $('#' + prefix + '-server');
	if (server.length) post.server = server.val();
	// Hidden for a server, which has none: what is left in it is not sent.
	var copy = $('#' + prefix + '-copy-keeps');
	if (copy.length) post.copy_keeps = post.server ? '' : copy.val();
	var leave = $('#' + prefix + '-leave-out');
	if (leave.length) post.leave_out = leave.val();
	zfsmSchedulesSend(post, function(answer) {
		status.css('color', answer.error ? '#e22828' : '').text([answer.said, answer.error].filter(Boolean).join('. '));
	});
}
['zfsm-snapsched', 'zfsm-copysched'].forEach(function(prefix) {
	$('#' + prefix + '-every, #' + prefix + '-server').on('change', function() { zfsmEverySync(prefix); });
	zfsmEverySync(prefix);
});
function zfsmSendTest(name, id) {
	var status = $(document.getElementById(id)).css('color', '').text('Asking…');
	zfsmSendPost({cmd: 'replicatest', name: name}, function(answer) {
		if (answer.error) return status.css('color', '#e22828').text(answer.error);
		status.text('Ready: copies go into '+answer.area);
	});
}
// Accept Replicas Into, checked on load too (no change event) so the saved value shows its warning; an answer for a value changed since is dropped.
function zfsmCheckAccept() {
	var input = $('input[name="replica_accept"]');
	var value = input.val();
	var warning = $('#zfsm-replica-accept-warning').text('');
	if (value === '') return;
	zfsmSendPost({cmd: 'validateaccept', dataset: value}, function(answer) {
		if (input.val() !== value) return;
		if (answer.error) return warning.text('This dataset could not be checked: '+answer.error);
		if (!answer.valid) return warning.text('Not a dataset inside a pool, so nothing is accepted.');
		if (answer.missing === null) return warning.text('Whether this dataset exists could not be read.');
		if (answer.missing) warning.text('This dataset does not exist, so nothing is accepted: create it first (Main, Create Dataset).');
	});
}
$('input[name="replica_accept"]').on('change', zfsmCheckAccept);
zfsmCheckAccept();
// Asks the server what asked() gives now: Apply on fields waits for the answer (Enter straight after typing would save a value
// unchecked), and is refused while the answer warns; an answer for values no longer shown is dropped.
function zfsmCheckHeld(fields, warning, asked, checking) {
	var sent = asked();
	fields.each(function() { this.setCustomValidity(checking); });
	warning.text('');
	zfsmSendPost(sent, function(answer) {
		if (JSON.stringify(asked()) !== JSON.stringify(sent)) return;
		var refused = answer.error ? '' : answer.warning;
		warning.text(answer.error ? 'This could not be checked: '+answer.error : refused);
		fields.each(function() { this.setCustomValidity(refused); });
	});
}
// Keep Replicas, checked as it is typed: refused while the server can't read it (all stay); empty asks nothing.
function zfsmCheckKeep() {
	var input = $('input[name="replica_keep"]');
	if (input.val().trim() !== '') return zfsmCheckHeld(input, $('#zfsm-replica-keep-warning'), function() { return {cmd: 'validatekeep', keep: input.val()}; }, 'Checking what this keeps');
	input[0].setCustomValidity('');
	$('#zfsm-replica-keep-warning').text('');
}
$('input[name="replica_keep"]').on('input', zfsmCheckKeep);
// Apply saves Keep Replicas twice: an older version's Apply leaves replica_keep_rules as it was (zfsmKeepReplicaText).
$('input[name="replica_keep"]').closest('form').on('submit', function() { $('input[name="replica_keep_rules"]').val($('input[name="replica_keep"]').val()); });
// Snapshots Pattern, Prefix and Time, checked as they change: refused while the server says ZFS refuses a name they give.
function zfsmCheckSnapName() {
	zfsmCheckHeld($('input[name="snap_pattern"], input[name="snap_prefix"]'), $('#zfsm-snap-name-warning'), function() {
		return {cmd: 'validatesnapname', pattern: $('input[name="snap_pattern"]').val(), prefix: $('input[name="snap_prefix"]').val(), utc: $('select[name="snap_utc"]').val()};
	}, 'Checking the names these give');
}
$('input[name="snap_pattern"], input[name="snap_prefix"]').on('input', zfsmCheckSnapName);
$('select[name="snap_utc"]').on('change', zfsmCheckSnapName);
</script>
