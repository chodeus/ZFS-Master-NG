<script>
  var zfsm_csrf_token = (typeof csrf_token !== 'undefined' && csrf_token) ? csrf_token : '<?=htmlspecialchars($csrf_token, ENT_QUOTES, 'UTF-8')?>';

  zfsmMoveStatusIntoTitle(document.getElementById('zfs-master-title'));

  var zfs_sub = null;
  var zfsm_inventory = null;
  var zfsm_config = <?=json_encode($zfsm_cfg, JSON_HEX_TAG | JSON_HEX_AMP)?>;

  function zfsmStatus(message, error = false) {
	$('#zfsm-last-refresh').text(message).css('color', error ? '#e22828' : '');
	$('#zfsm-loading td').text(message);
  }

  if (zfsm_config['version'].localeCompare('6.12.13', undefined, { numeric: true, sensitivity: 'base' }) == 1) {
	$('#zfs_master').removeClass('disk_status legacy');
  }

  function zfsmHandleMessage(data) {
	var msg;
	try {
		msg = parseJSONResponse(data);
    // Old/retained daemon inventory must never replace newer HTTP results.
    if (msg.op == 'start_directory_copy') {
		Swal2.fire({
		  title: '<strong>Copying Directory</strong>',
		  icon: 'warning',
		  html: 'Starting...',
		  timer: 3000,
		  footer: 'Operation is in progress, it cannot be interrupted, check the progress on the dataset row',
		  didOpen: () => {
    		Swal2.showLoading();
		  }
	  	});
	} else if (msg.op == 'directory_copy') {
		htmlProgress = parseDirectoryCopy(msg.data.line);
		$(document.getElementById(datasetRowId(msg.data.dataset))).children('td:nth-child(1)').html(htmlProgress);
	} else if (msg.op == 'stop_directory_copy') {
		$(document.getElementById(datasetRowId(msg.data.dataset))).children('td:nth-child(1)').text('');
	}

	processHiddenDatasets();
	} catch (error) {
		console.error('ZFS Master NG copy-progress message failed', error);
	}
  }

  $(function() {
	try {
		zfsm_inventory = createZFSMInventoryController({
			url: '<?=$urlzmadmin?>', csrf: zfsm_csrf_token, config: zfsm_config,
			status: zfsmStatus,
			configChanged: function(config) { zfsm_config = config; },
			spinner: function(active) {
				$('#zfsm-refresh').removeClass(active ? 'fa-refresh fa-arrows-rotate' : 'fa-spinner fa-spin')
					.addClass(active ? 'fa-spinner fa-spin' : 'fa-refresh fa-arrows-rotate');
			},
			render: function(data, complete) {
				updateFullBodyTable(data, zfsm_config['destructive_mode'], zfsm_config['snap_max_days_alert'], <?=json_encode($display, JSON_HEX_TAG | JSON_HEX_AMP)?>, zfsm_config['directory_listing']);
				processHiddenDatasets();
				if (complete) saveCache(data);
			}
		});
		installZFSMActionRefresh(requestRefresh);
		if (Number(zfsm_config.refresh_interval) === 0) {
			if (!loadCache()) zfsmStatus('Automatic refresh is disabled and no cached data is available. Click Refresh to load pools.');
		} else {
			requestRefresh();
		}
	} catch (error) {
		console.error('ZFS Master NG startup failed', error);
		zfsmStatus('ZFS Master NG startup failed: '+error.message, true);
	}
	// Optional progress feed: its absence cannot block inventory or actions.
	try {
		zfs_sub = new NchanSubscriber('/sub/zfs_master',{subscriber:'websocket'});
		zfs_sub.on('message', zfsmHandleMessage);
		zfs_sub.start();
	} catch (error) {
		console.warn('ZFS Master NG live copy progress is unavailable', error);
	}
	window.addEventListener('pagehide', function() { if (zfsm_inventory) zfsm_inventory.stop(); });
  });

  $(document).click(function() {
	  removeContext();
  })

  function requestRefresh() {
	if (zfsm_inventory) zfsm_inventory.refresh();
  }
  
  function replaceElementClass(element, oldClass, newClass){
	  $(element).removeClass(oldClass);
	  $(element).addClass(newClass);
  }
  
  function getUnraidParentElement() {
	  if (zfsm_config['version'].localeCompare('6.11.9', undefined, { numeric: true, sensitivity: 'base' }) == 1) {
		return $('.title .left').filter(function(){return $(this).text() === 'ZFS Master NG';}).parent();
	  }
	  return $('div#title > span.left').filter(function(){return $(this).text() === 'ZFS Master NG';}).parent();
  }

  function saveCache(data) {
	const curDate = new Date();
	
	data['timestamp'] = curDate.toLocaleString('en-US', { hour12: false })

	saveToLocalStorage('zfsm-cache', data);
  }
  
  function updateSnapshotCache(data, total_snaps) {
	var cache = loadFromLocalStorage('zfsm-cache');

	if (cache === null) {
		return;
	}

	const stack = [cache];
	var dataset =  null;

	while (stack.length > 0) {
		const currentObj = stack.pop();

		if (typeof currentObj !== 'object') {
			continue;
		}

		for (const key in currentObj) {
			if (key === data.dataset['name']) {
				dataset = currentObj[key];
			}

			if (typeof currentObj[key] === 'object') {
				stack.push(currentObj[key]);
			}
		}
	}

	if (dataset === null)
		return;

	dataset['snapshots'] = data['snapshots'];
	cache['pools'][data['pool']]['Snapshots'] = total_snaps + data['snapshots'].length;

	saveCache(cache);
  }

  function loadCache() {
	var data = loadFromLocalStorage('zfsm-cache');

	if (!data || typeof data !== 'object' || !data.pools || !data.datasets || !data.devices) {
		return false;
	}

	updateFullBodyTable(data, zfsm_config['destructive_mode'], zfsm_config['snap_max_days_alert'], <?=json_encode($display, JSON_HEX_TAG | JSON_HEX_AMP)?>, zfsm_config['directory_listing']);

	const notes = zfsmInventoryNotes(data);
	zfsmStatus('Last refresh at '+data.timestamp+notes, notes !== '');

	processHiddenDatasets();
	return true;
  }

  function processHiddenDatasets() {
	var datasets = loadFromLocalStorage('zfsm-datasetsHidden');
	
	if (!datasets || !Array.isArray(datasets.hidden) || datasets.hidden.length <= 0)
		return;

	for (let zdataset of datasets.hidden) {
		var myRows = document.getElementsByClassName(datasetChildClass(zdataset));
		
		for (let row of myRows) {
			$(row).hide(0);
			$('i[name=\''+zdataset+'\']').attr('class', 'fa fa-plus-square fa-append');
		} 
	}
  }

  function toggleDataset(zdataset) {
	var datasets = loadFromLocalStorage('zfsm-datasetsHidden');
	var index = -1;

	if (datasets === null) {
		datasets = {hidden : []};
	}

	var index = datasets.hidden.indexOf(zdataset);

	if (index > -1) {
		datasets.hidden.splice(index, 1);
	} else {
		datasets.hidden.push(zdataset);
	}

	var myRows = document.getElementsByClassName(datasetChildClass(zdataset));

	for (let row of myRows) {
		if (index == -1) {
			$(row).hide( 'fast');
			$('i[name=\''+zdataset+'\']').attr('class', 'fa fa-plus-square fa-append');
		} else {
			$(row).show( 'fast');
			$('i[name=\''+zdataset+'\']') .attr('class', 'fa fa-minus-square fa-append');
		}
	}

	saveToLocalStorage('zfsm-datasetsHidden', datasets);

	processHiddenDatasets();
  }
  
  function togglePoolTable(zpool_id, trclass) {
	var datasets = loadFromLocalStorage('zfsm-datasetsHidden');
	var myArray = document.getElementsByClassName(trclass);
	var myButton = document.getElementById(zpool_id);
	var visibility = loadFromLocalStorage(trclass, false);

	if (datasets === null) {
		datasets = {hidden:[]};
	}

	for (let mytr of myArray) {
		if (visibility == 'hide') {
			var classList = $(mytr).attr('class').split(/\s+/);
			if (datasets.hidden.some(function(name) { return classList.includes(datasetChildClass(name)); })) {
				continue;
			}

			$(mytr).show('slow');
			myButton.firstChild.data = 'Hide Datasets';
		} else {
			removeFromLocalStorage(trclass);	
			$(mytr).hide('slow');
			myButton.firstChild.data = 'Show Datasets';
		}
	}

	if (visibility == 'hide') {
		saveToLocalStorage(trclass, 'show', false);	
	} else {
		saveToLocalStorage(trclass, 'hide', false);	
	}
  }
  
  function createDataset(zpool) {
	openBox('<?=$urlcreatedataset?>?zpool='+encodeURIComponent(zpool),'Create Dataset',550,680,false);
  }

  function addDirectoryContext(directory, pool, id, destructive_mode) {
	var opts = [];

	opts.push({header:directory});

	if (destructive_mode != 0) {
		opts.push(
		  {
			text: _('Convert to Dataset'),
			icon: 'fa-files-o',
			action: function (e) {
				e.preventDefault();
				convertDirectory(directory, pool);
		    }
		  },
		  { divider: true },
		  {
			text: _('Delete'),
			icon: 'fa-trash',
			action: function (e) {
				e.preventDefault();
				deleteDirectory(directory);
		    }
		  }
		);
	}

	opts.push(
		{
			text: _('Move/Rename'),
			icon: 'fa-font',
			action: function (e) {
				e.preventDefault();
				moveDirectory(directory);
			}
		},
	);

    context.attach('#' + id, opts);
  }

  function addDatasetContext(zpool, zdataset, snapscount, id, destructive_mode, encryption, origin, datasetType) {
	var opts = [];
	var edit_opts = [];

	if (datasetType === 'filesystem') {
		edit_opts.push(
			{text: _('Mountpoint'), action: function(e) { e.preventDefault(); editDatasetProperty(zdataset, 'mountpoint'); }},
			{text: _('Quota'), action: function(e) { e.preventDefault(); editDatasetProperty(zdataset, 'quota'); }},
			{text: _('Record Size'), action: function(e) { e.preventDefault(); editDatasetProperty(zdataset, 'recordsize'); }},
			{text: _('Access Time (atime)'), action: function(e) { e.preventDefault(); editDatasetProperty(zdataset, 'atime'); }},
			{text: _('Extended Attributes (xattr)'), action: function(e) { e.preventDefault(); editDatasetProperty(zdataset, 'xattr'); }}
		);
	}

	edit_opts.push(
		{
			text: _('Compression'),
			action: function(e) {
				e.preventDefault();
				editDatasetProperty(zdataset, 'compression');
			}
		},
		{
			text: _('Primary Cache'),
			action: function(e) {
				e.preventDefault();
				editDatasetProperty(zdataset, 'primarycache');
			}
		},
		{
			text: _('Read Only'),
			action: function(e) {
				e.preventDefault();
				editDatasetProperty(zdataset, 'readonly');
			}
		},
		{
			text: _('Sync'),
			action: function(e) {
				e.preventDefault();
				editDatasetProperty(zdataset, 'sync');
			}
		}
	);

	opts.push({header:zdataset});

	if (destructive_mode != 0) {
		opts.push(
		  {
			text: _('Rename'),
			icon: 'fa-font',
			action: function (e) {
				e.preventDefault();
				renameDataset(zdataset);
			}
		  },
		  {
			text: _('Edit Dataset'),
			icon: 'fa-pencil',
			subMenu: edit_opts
		  },
		  {
			text: _('Destroy'),
			icon: 'fa-trash',
			action: function (e) {
				e.preventDefault();
				destroyDataset(zdataset);
		    }
		  },
		  { divider: true }
		);
	}

    opts.push({
        text: _('Take Snapshot'),
        icon: 'fa-camera-retro',
		action: function (e) {
			e.preventDefault();
			takeDatasetSnapshot(zdataset);
        },
    });
    
	if (encryption == 'available') {
		opts.push({
			text: _('Lock Dataset'),
			icon: 'fa-lock',
			action: function(e) {
				e.preventDefault();
				lockDataset(zdataset);
			},
		});
	} else if (encryption == 'unavailable') {
		opts.push({
			text: _('Unlock Dataset'),
			icon: 'fa-unlock',
			action: function(e) {
				e.preventDefault();
				unlockDataset(zdataset);
			},
		});
	}

	if (origin) {
		opts.push({
			text: _('Promote Dataset'),
			icon: 'fa-upload',
			action: function(e) {
				e.preventDefault();
				promoteDataset(zdataset);
			},
		});
	}

	if (snapscount >= 1) {
        opts.push({
			text: _('Snapshots Admin'),
			icon: 'fa-gears',
			action: function(e) {
				e.preventDefault();
				adminDatasetSnaps(zpool, zdataset);
			},
		});
    }

	if (datasetType !== 'filesystem') {
		// Volumes have no directory tree.
	} else if (!zfsm_config['directory_listing'].includes(zdataset)) {
		opts.push({
			text: _('Add Directory Listing'),
			icon: 'fa-folder',
			action: function (e) {
				e.preventDefault();
				addDirectoryListing(zdataset);
			},
		});
	} else {
		opts.push({
			text: _('Remove Directory Listing'),
			icon: 'fa-folder',
			action: function (e) {
				e.preventDefault();
				removeDirectoryListing(zdataset);
			},
		});
	}

    context.attach('#' + id, opts);

  }

  function removeContext() {
	$(`[id*="dropdown-"]`).each(function() {
		if (!$(this).hasClass('dropdown-menu-context')) {
			$(this).hide()
		}
    })
  }

  function takeDatasetSnapshot(zdataset) {
	  Swal2.fire({
		  title: '<strong>Take Dataset <br>'+escapeHtml(zdataset)+'</strong> Snapshot',
		  icon: 'question',
		  html: 'This operation will take a Snapshot of the Dataset, are you sure?',
		  input: 'checkbox',
		  inputPlaceholder: 'Recursively create snapshots of all descendent datasets',
		  showConfirmButton: true,
		  confirmButtonText: 'Snapshot',
		  showCancelButton: true
	  }).then((result) => {
		  if (result.isConfirmed) {
			  $.post('<?=$urlzmadmin?>',{cmd: 'snapshotdataset', zdataset: zdataset, recursive: result.value}, function(data) {
				Swal2.fire({
					title: 'Snapshot Result',
					icon: 'info',
					html: formatAnswer(parseJSONResponse(data))
				});
			  });
		  }
	  });
  }

  function getPropertyEditHTML(zdataset, property, value) {
	var tmpHTML = '';

	switch (property) {
		case 'mountpoint':
			return '<input id="zfsm-swal-input" maxlength="256" autocapitalize="off" autocorrect="off" class="swal2-input" placeholder="Dataset new mountpoint (Full path)" value="'+escapeHtml(value)+'" type="text" style="display: flex;">';
		case 'quota':
			if (value) {
				value = fromBytesToString(value).replace(/ +/g, '');
			}

			return '<input id="zfsm-swal-input" name="quota" class="swal2-input zfsm-w10" maxlength="16" value="'+escapeHtml(value)+'">';
		case 'compression':
			tmpHTML = '<select id="zfsm-swal-input" name="compression" class="swal2-input"><option value="inherit">Inherit</option><option value="off">Off</option><option value="lz4">lz4</option><option value="gzip">gzip</option><option value="zstd">zstd</option></select>';
			break;
		case 'recordsize':
			tmpHTML ='<select id="zfsm-swal-input" name="recordsize" class="zfsm-input"><option value="inherit">Inherit</option><option value="512">512 B</option><option value="4096">4 KiB</option><option value="8192">8 KiB</option><option value="16384">16 KiB</option><option value="65536">64 KiB</option><option value="131072">128 KiB</option><option value="1048576">1 MiB</option></select>';
			break;
		case 'atime':
			tmpHTML = '<select id="zfsm-swal-input" name="atime" class="zfsm-input"><option value="inherit">Inherit</option><option value="off">Off</option><option value="on">On</option></select>';
			break;
		case 'xattr':
			tmpHTML = '<select id="zfsm-swal-input" name="xattr" class="zfsm-input"><option value="inherit">Inherit</option><option value="sa">sa</option><option value="on">on</option><option value="off">off</option></select>';
			break;
		case 'primarycache':
			tmpHTML = '<select id="zfsm-swal-input" name="primarycache" class="zfsm-input"><option value="inherit">Inherit</option><option value="all">All</option><option value="metadata">Metadata</option><option value="none">None</option></select>';
			break;
		case 'readonly':
			tmpHTML = '<select id="zfsm-swal-input" name="readonly" class="zfsm-input"><option value="off">Off</option><option value="on">On</option></select>';
			break;
		case 'sync':
			tmpHTML = '<select id="zfsm-swal-input" name="sync" class="zfsm-input"><option value="standard">Standard</option><option value="always">Always</option><option value="disabled">Disabled</option></select>';
			break;
	}

	var element = $(tmpHTML);
	var current = element.find('option').filter(function() { return $(this).val() === String(value); });
	// A value the list lacks (zstd-3, 32K) is offered too, or the dialog opens on another value.
	if (!current.length && value != null && value !== '') current = $('<option>').val(String(value)).text(String(value)).appendTo(element);
	// An attribute, not prop(): outerHTML drops a selected property and the dialog opened on the first option.
	current.attr('selected', 'selected');
	var res = element.prop('outerHTML');

	return res;
  }

  // Swal2 resets the body's display after fire(); this must run as didOpen.
  function zfsmGridBody(popup) {
	popup.querySelector('.swal2-html-container').style.display = 'grid';
  }

  function editDatasetProperty(zdataset, property) {
	var properties = {};

	$.post('<?=$urlzmadmin?>',{cmd: 'getdatasetproperties', zdataset: zdataset}, function(data) {
		properties = parseJSONResponse(data);
		if (properties._error) {
			Swal2.fire({title: 'Unable to read properties', icon: 'error', text: properties._error});
			return;
		}

		Swal2.fire({
			title: '<strong>'+escapeHtml(zdataset)+' - '+escapeHtml(property)+'</strong>',
			html: getPropertyEditHTML(zdataset, property, properties[property]),
			didOpen: zfsmGridBody,
			showConfirmButton: true,
			showCancelButton: true,
			preConfirm: function () {
				var control = $('#zfsm-swal-input');
				var shown = control.is('select') ? control.find('option[selected]').val() : control.attr('value');
				return [control.val(), shown];
			}
		}).then((result) => {
			// Sending the value it opened with would round a quota or make an inherited value local.
			if (result.isConfirmed && result.value[0] !== result.value[1]) {
				$.post('<?=$urlzmadmin?>',{cmd: 'editdatasetproperty', zdataset: zdataset, property: property, value: result.value[0]}, function(data) {
					Swal2.fire({
						title: 'Edit Result',
						icon: 'info',
						html: formatAnswer(parseJSONResponse(data))
					});
				});
			}
		});
	});
  }

