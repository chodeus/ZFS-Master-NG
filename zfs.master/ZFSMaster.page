  function destroyDataset(zdataset) {
	  Swal2.fire({
		  title: '<strong>Destroy Dataset<br>'+escapeHtml(zdataset)+'</strong>',
		  icon: 'warning',
		  html: 'This operation will destroy the Dataset, <b>which cannot be undone</b>, are you sure?',
