  function reviewDatasetDestroy(zdataset, force) {
	  zfsmFetchReview('<?=$urlzmadmin?>', {cmd: 'previewdestroy', target: zdataset, force: force}, function(preview) {
		  Swal2.fire({
			  title: '<strong>Review: Destroy '+escapeHtml(zdataset)+'</strong>',
			  icon: preview.can_proceed ? 'warning' : 'error',
			  html: zfsmImpactHtml(preview, zfsmImpactSummary(preview, 'destroys')),
			  showConfirmButton: preview.can_proceed,
			  confirmButtonText: 'Destroy',
			  showCancelButton: true
		  }).then((result) => {
			  if (!result.isConfirmed) return;
			  $.post('<?=$urlzmadmin?>',{cmd: 'destroydataset', zdataset: zdataset, force: force, token: preview.token}, function(answer) {
				  Swal2.fire({
					  title: 'Destroy Result',
					  icon: 'info',
					  html: formatAnswer(parseJSONResponse(answer))
				  });
			  });
		  });
	  });
  }

