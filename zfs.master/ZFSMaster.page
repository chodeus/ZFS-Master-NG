  function convertDirectory(directory, pool) {
	const title = '<strong> Convert '+escapeHtml(directory)+' to Dataset</strong>';
	// The review says first whether the files are cloned, and what a first clone turns on (zfsmConvertPreview).
	zfsmFetchReview('<?=$urlzmadmin?>', {cmd: 'previewconvert', directory: directory, pool: pool}, function(preview) {
	  if (preview.can_proceed !== true) {
		  Swal2.fire({title: title, icon: 'error', html: escapeHtml(preview.error || 'The convert cannot start.')});
		  return;
	  }
	  Swal2.fire({
		  title: title,
		  icon: 'warning',
		  html: zfsmConvertHtml(preview),
		  showConfirmButton: true,
		  confirmButtonText: 'Convert',
		  showCancelButton: true
	  }).then((result) => {
		  if (result.isConfirmed) {
			  // The copy is over once this request returns, whether or not its stop message arrived.
			  $.post('<?=$urlzmadmin?>',{cmd: 'convertdirectory', directory: directory, pool: pool, clone: preview.clones ? 1 : 0}, function(data) {
				Swal2.fire({
					title: 'Convert Result',
					icon: 'info',
					html: formatAnswer(parseJSONResponse(data))
				});
			  }).always(zfsmClearCopyProgress);
		  }
	  });
	});
  }

