<!-- A failed download never reaches upgradepkg: the running install and the archive the next boot needs stay intact.
     The lock (include/ZFSMInstallLock.php) keeps scripts/ from loading while upgradepkg replaces the plugin's files. -->
<FILE Name="/boot/config/plugins/&name;/&pkgname;.txz" Run="flock /var/run/zfs.master.install.lock upgradepkg --install-new --reinstall">
<URL>https://github.com/&github;/releases/download/v&version;/&pkgname;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
# Older versions ran an inventory daemon; a stale nchan.pid entry would restart it on every page load
pkill -f '/plugins/zfs.master/nchan/zfs_master' 2>/dev/null || true
if [ -e /var/run/nchan.pid ]; then
  sed -ri '\#^plugins/zfs\.master/nchan/zfs_master(:|$)#d' /var/run/nchan.pid
fi
for p in /var/log/packages/&name;-*; do
  [ -e "$p" ] || continue
  case "$(basename "$p")" in &pkgname;) continue;; esac
  rm -f "$p"
done
rm -f $(ls /boot/config/plugins/&name;/&name;-*.t?z 2>/dev/null | grep -vF '&pkgname;')
# Older versions unpacked a tar with no package record, so upgradepkg leaves these behind
rm -f &plugdir;/nchan/zfs_master &plugdir;/scripts/zfs_*.lua
rmdir &plugdir;/nchan 2>/dev/null || true
rm -f /tmp/zfsm_reload
# An older version's schedule change drops what it can't read from the cron file and the schedules: put back as this one reads them
/usr/bin/php &plugdir;/scripts/schedule.php heal
echo ""
echo "-----------------------------------------------------------"
echo " ZFS Master NG has been installed."
echo " Version: &version;"
echo " Hard-refresh your browser if the Main tab looks wrong."
echo ""
echo " Maintained by:"
echo "   2026-present  chodeus (ZFS Master NG)"
echo "   2026          dlang123 (Unraid 7.3 port)"
echo "   2021-2024     IkerSaint (ZFS Master)"
echo ""
echo " GitHub: github.com/&github;"
echo " Issues: github.com/&github;/issues"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
echo "Removing &name;..."
pkill -f '/plugins/zfs.master/nchan/zfs_master' 2>/dev/null || true
if [ -e /var/run/nchan.pid ]; then
  sed -ri '\#^plugins/zfs\.master/nchan/zfs_master(:|$)#d' /var/run/nchan.pid
fi
for p in /var/log/packages/&name;-*; do
  [ -e "$p" ] || continue
  removepkg "$(basename "$p")"
done
rm -rf /boot/config/plugins/&name;
rm -rf &plugdir;
rm -f /tmp/zfsm_reload /var/log/&name;.log /var/log/&name;.log.1
# A diagnostics work folder goes only when it is root's own, has a name a run makes (16 hex digits), holds no mount and no run
# holds its lock. An unread or empty mount table removes nothing: what is mounted in a folder is not the plugin's.
for d in /tmp/&name;-diag.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]; do
  [ -d "$d" ] || continue
  [ ! -L "$d" ] || continue
  [ -O "$d" ] || continue
  awk -v d="$d" '$5 == d || index($5, d "/") == 1 { n = 1 } END { exit (n || NR == 0) }' /proc/self/mountinfo || continue
  flock -n "$d" rm -rf --one-file-system -- "$d" || continue
done
echo ""
echo "-----------------------------------------------------------"
echo " ZFS Master NG has been removed."
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>
</PLUGIN>
