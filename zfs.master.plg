</CHANGES>

<!-- A failed download never reaches upgradepkg: the running install and the archive the next boot needs stay intact -->
<FILE Name="/boot/config/plugins/&name;/&pkgname;.txz" Run="upgradepkg --install-new --reinstall">
<URL>https://github.com/&github;/releases/download/v&version;/&pkgname;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
# Older versions ran an inventory daemon; a stale nchan.pid entry would restart it on every page load
pkill -f '/plugins/zfs.master/nchan/zfs_master' 2>/dev/null || true
if [ -e /var/run/nchan.pid ]; then
  sed -ri '/zfs_master(:|$)/d' /var/run/nchan.pid
fi
for p in /var/log/packages/&name;-*; do
  [ -e "$p" ] || continue
  case "$(basename "$p")" in &pkgname;) continue;; esac
  rm -f "$p"
done
rm -f $(ls /boot/config/plugins/&name;/&name;-*.t?z 2>/dev/null | grep -vF '&pkgname;')
# Older versions unpacked a tar with no package record, so upgradepkg leaves these behind
rm -f &plugdir;/nchan/zfs_master &plugdir;/scripts/zfs_*.lua
rmdir &plugdir;/nchan &plugdir;/scripts 2>/dev/null || true
rm -f /tmp/zfsm_reload
echo ""
echo "-----------------------------------------------------------"
echo " &name; has been installed."
echo " Version: &version;"
echo " Hard-refresh your browser if the Main tab looks wrong."
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
echo "Removing &name;..."
pkill -f '/plugins/zfs.master/nchan/zfs_master' 2>/dev/null || true
if [ -e /var/run/nchan.pid ]; then
  sed -ri '/zfs_master(:|$)/d' /var/run/nchan.pid
fi
for p in /var/log/packages/&name;-*; do
  [ -e "$p" ] || continue
  removepkg "$(basename "$p")"
done
rm -rf /boot/config/plugins/&name;
rm -rf &plugdir;
rm -f /tmp/zfsm_reload
echo ""
echo "-----------------------------------------------------------"
echo " &name; has been removed."
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>
</PLUGIN>
