#!/bin/sh

contains_arg() {
	needle="$1"
	shift
	for arg in "$@"; do
		[ "$arg" = "$needle" ] && return 0
	done
	return 1
}

last_arg=''
for arg in "$@"; do last_arg="$arg"; done

if [ "$1" = "destroy" ] && contains_arg '-n' "$@"; then
	if [ "${ZFSM_TEST_DESTROY_REFUSED:-0}" = 1 ]; then
		# Like ZFS, the refusal runs over several lines.
		printf "cannot destroy '%s': filesystem has children\nuse '-r' to destroy the following datasets:\n%s/child\n" "$last_arg" "$last_arg" >&2
		exit 1
	fi
	# Like ZFS, a snapshot list (tank/data@a,b) prints one line per snapshot.
	case "$last_arg" in
		*@*,*) old_ifs=$IFS; IFS=,; for snap in ${last_arg#*@}; do printf 'destroy\t%s@%s\n' "${last_arg%%@*}" "$snap"; done; IFS=$old_ifs ;;
		*) printf 'destroy\t%s\n' "$last_arg" ;;
	esac
	[ "${ZFSM_TEST_LEAF:-0}" != 1 ] && contains_arg '-r' "$@" && printf 'destroy\t%s/child\ndestroy\t%s@daily\n' "$last_arg" "$last_arg"
	[ -n "${ZFSM_TEST_DESTROY_EXTRA:-}" ] && printf 'destroy\t%s\n' "$ZFSM_TEST_DESTROY_EXTRA"
	case "$last_arg" in *@*) printf 'reclaim\t2048\n' ;; esac
	exit 0
fi

if [ "$1" = "destroy" ] && [ "${ZFSM_TEST_DESTROY_BUSY:-0}" = 1 ]; then
	# Like ZFS, -v names each dataset before the unmount fails.
	contains_arg '-v' "$@" && printf 'will destroy %s\n' "$last_arg"
	printf "cannot unmount '/mnt/%s/child': pool or dataset is busy\ncannot destroy '%s': dataset is busy\n" "$last_arg" "$last_arg" >&2
	[ -n "${ZFSM_TEST_LOG:-}" ] && printf '%s\n' "$*" >> "$ZFSM_TEST_LOG"
	exit 1
fi

if [ "$1" = "list" ] && contains_arg 'used' "$@"; then
	[ "${ZFSM_TEST_USED_FAIL:-0}" = 1 ] && { printf 'simulated used failure\n' >&2; exit 1; }
	printf '4096\n'
	exit 0
fi

if [ "$1" = "list" ] && contains_arg 'name,origin' "$@"; then
	[ "${ZFSM_TEST_ORIGIN_FAIL:-0}" = 1 ] && { printf 'simulated origin failure\n' >&2; exit 1; }
	printf 'tank\t-\ntank/data\t-\n'
	[ -n "${ZFSM_TEST_CLONE:-}" ] && printf 'tank/clone\t%s\n' "$ZFSM_TEST_CLONE"
	exit 0
fi

if [ "$1" = "list" ] && contains_arg 'name,userrefs' "$@"; then
	printf '%s@daily\t%s\n' "$last_arg" "${ZFSM_TEST_HOLDS:-0}"
	exit 0
fi

if [ "$1" = "list" ] && contains_arg 'name,createtxg' "$@"; then
	[ "${ZFSM_TEST_TXG_FAIL:-0}" = 1 ] && { printf 'simulated txg failure\n' >&2; exit 1; }
	printf '%s@old\t99\n%s@daily\t100\n%s@new\t101\n%s#mark\t1000\n' "$last_arg" "$last_arg" "$last_arg" "$last_arg"
	[ -n "${ZFSM_TEST_TXG_EXTRA:-}" ] && printf '%s@%s\t2000\n' "$last_arg" "$ZFSM_TEST_TXG_EXTRA"
	[ -n "${ZFSM_TEST_TXG_BOOKMARK:-}" ] && printf '%s#%s\t2001\n' "$last_arg" "$ZFSM_TEST_TXG_BOOKMARK"
	exit 0
fi

if [ "$1" = "list" ] && contains_arg 'name,mountpoint' "$@" && contains_arg '-r' "$@" && [ "${ZFSM_TEST_USERS_LIST_FAIL:-0}" = 1 ]; then
	printf "cannot open '%s': simulated failure\n" "$last_arg" >&2
	exit 1
fi

if [ "$1" = "list" ] && contains_arg 'name,mountpoint' "$@" && [ -n "${ZFSM_TEST_USERS_MOUNT:-}" ]; then
	printf '%s\t%s\n' "$last_arg" "$ZFSM_TEST_USERS_MOUNT"
	exit 0
fi

if [ "$1" = "list" ] && contains_arg 'name,mountpoint' "$@" && contains_arg 'filesystem' "$@"; then
	printf 'tank\t/tmp/zfsm-test-mount\n'
	exit 0
fi

if [ "$1" = "list" ] && contains_arg 'filesystem,volume' "$@" && contains_arg '-r' "$@"; then
	printf 'tank\tfilesystem\t100\t900\t80\toff\t-\t/mnt/tank\tlz4\t1.00x\t20\tnone\t131072\ton\tsa\tall\toff\tsensitive\tstandard\t1700000000\t-\t-\n'
	printf 'tank/data\tfilesystem\t60\t900\t50\toff\t-\t/mnt/tank/data\tzstd\t1.25x\t10\tnone\t131072\ton\tsa\tall\toff\tsensitive\tstandard\t1700000100\t-\t-\n'
	printf 'tank/vol\tvolume\t40\t900\t30\toff\t-\t-\tlz4\t1.10x\t10\t-\t-\t-\t-\tall\toff\t-\tstandard\t1700000200\t-\t16384\n'
	exit 0
fi

if [ "$1" = "list" ] && contains_arg 'snapshot' "$@" && contains_arg '-r' "$@"; then
	if [ "${ZFSM_TEST_SNAPSHOT_FAIL:-0}" = 1 ]; then
		printf 'simulated snapshot query failure\n' >&2
		exit 1
	fi
	printf 'tank@root\t1\t80\t1\toff\t0\t1700000300\n'
	printf 'tank/data@daily\t2\t50\t2\toff\t0\t1700000400\n'
	exit 0
fi

# Every snapshot with its creation time, as the alert check reads them.
if [ "$1" = "list" ] && [ "$last_arg" = "name,creation" ]; then
	[ "${ZFSM_TEST_SNAPSHOT_LIST_FAIL:-0}" = 1 ] && { printf 'simulated snapshot list failure\n' >&2; exit 1; }
	[ -n "${ZFSM_TEST_SNAPSHOT_LIST:-}" ] && cat "$ZFSM_TEST_SNAPSHOT_LIST"
	exit 0
fi

if [ "$1" = "list" ] && contains_arg 'snapshot' "$@" && contains_arg '-d' "$@"; then
	if [ "${ZFSM_TEST_DATASET_SNAPSHOTS_FAIL:-0}" = 1 ]; then
		printf 'simulated dataset snapshot failure\n' >&2
		exit 1
	fi
	if [ "$last_arg" = "tank" ]; then
		printf 'tank@root\t1\t80\t1\toff\t0\t1700000300\n'
	else
		printf '%s@daily\t2\t50\t2\toff\t0\t1700000400\n' "$last_arg"
		[ "${ZFSM_TEST_SNAPSHOT_AUTO:-0}" = 1 ] && printf '%s@autosnap_2023-11-14_22:15:00_hourly\t3\t60\t1\toff\t0\t1700000500\n' "$last_arg"
	fi
	exit 0
fi

if [ "$1" = "list" ] && [ -n "${ZFSM_TEST_LIST_FAIL:-}" ] && [ "$last_arg" = "$ZFSM_TEST_LIST_FAIL" ]; then
	printf "cannot open '%s': permission denied\n" "$last_arg" >&2
	exit 2
fi

# ZFSM_TEST_MISSING_DATASET is comma-separated; names may hold spaces.
if [ "$1" = "list" ] && [ -n "${ZFSM_TEST_MISSING_DATASET:-}" ]; then
	case ",$ZFSM_TEST_MISSING_DATASET," in
		*",$last_arg,"*) printf "cannot open '%s': dataset does not exist\n" "$last_arg" >&2; exit 1 ;;
	esac
fi

if [ "$1" = "list" ]; then
	printf '%s\n' "$last_arg"
	exit 0
fi

if [ "$1" = "get" ] && contains_arg 'name,property,value,source' "$@"; then
	printf 'tank\torg.example:role\tstorage\tlocal\n'
	printf 'tank/data\torg.example:role\tmedia\tlocal\n'
	exit 0
fi

if [ "$1" = "get" ] && [ -n "${ZFSM_TEST_GET_FAIL:-}" ] && [ "$last_arg" = "$ZFSM_TEST_GET_FAIL" ]; then
	printf "cannot open '%s': permission denied\n" "$last_arg" >&2
	exit 1
fi

if [ "$1" = "get" ] && contains_arg 'encryption' "$@"; then
	printf '%s\n' "${ZFSM_TEST_ENCRYPTION:-off}"
	exit 0
fi

if [ "$1" = "get" ] && contains_arg 'mounted' "$@"; then
	printf '%s\n' "${ZFSM_TEST_MOUNTED:-yes}"
	exit 0
fi

if [ "$1" = "get" ] && [ -n "${ZFSM_TEST_MOUNT_ROOT:-}" ]; then
	printf '%s/%s\n' "$ZFSM_TEST_MOUNT_ROOT" "$last_arg"
	exit 0
fi

if [ "$1" = "get" ]; then
	printf '%s\n' "${ZFSM_TEST_DATASET_MOUNT:-/mnt/tank/data}"
	exit 0
fi

if [ -n "$ZFSM_TEST_LOG" ]; then
	printf '%s\n' "$*" >> "$ZFSM_TEST_LOG"
fi

# Names as zfs diff escapes them: \0040 is a space, \0303\0251 is é.
if [ "$1" = "diff" ]; then
	[ "${ZFSM_TEST_DIFF_FAIL:-0}" = 1 ] && { printf 'Cannot diff an unmounted snapshot\n' >&2; exit 1; }
	[ "${ZFSM_TEST_DIFF_GARBLED:-0}" = 1 ] && { printf 'zfs diff: something else\n'; exit 0; }
	[ "${ZFSM_TEST_DIFF_SLOW:-0}" = 1 ] && { sleep 5; exit 0; }
	# Exits with an error before the reader sees its 1001st line: a background writer still holds the pipe.
	if [ "${ZFSM_TEST_DIFF_FAILED_EARLY:-0}" = 1 ]; then
		( sleep 0.3; i=0; while [ "$i" -lt 1500 ]; do printf 'M\tF\t/mnt/tank/data/file%s\n' "$i"; i=$((i + 1)); done ) &
		exit 1
	fi
	if [ -n "${ZFSM_TEST_DIFF_FAIL_AFTER:-}" ]; then
		i=0
		while [ "$i" -lt "$ZFSM_TEST_DIFF_FAIL_AFTER" ]; do printf 'M\tF\t/mnt/tank/data/file%s\n' "$i"; i=$((i + 1)); done
		printf 'Unable to determine path or stats for object 99 in tank/data@daily: Invalid argument\n' >&2
		exit 1
	fi
	if [ -n "${ZFSM_TEST_DIFF_ENDLESS:-}" ]; then
		# Like a zfs started from a parent that ignores SIGPIPE: only a signal stops it early.
		trap '' PIPE
		i=0
		while [ "$i" -lt 100000 ]; do printf 'M\tF\t/mnt/tank/data/file%s\n' "$i" 2>/dev/null; i=$((i + 1)); done
		: > "$ZFSM_TEST_DIFF_ENDLESS"
		exit 0
	fi
	printf '%s\t%s\t%s\n' '+' 'F' '/mnt/tank/data/new\0040file.txt' '-' '/' '/mnt/tank/data/old' 'M' 'F' '/mnt/tank/data/caf\0303\0251'
	printf '%s\t%s\t%s\t%s\n' 'R' 'F' '/mnt/tank/data/a' '/mnt/tank/data/b' 'M' 'F' '/mnt/tank/data/linked' '(+1)'
	exit 0
fi

if [ "$1" = "set" ] && [ "${ZFSM_TEST_SET_FAIL:-0}" = 1 ]; then
	printf "cannot set property for '%s': permission denied\n" "$last_arg" >&2
	exit 1
fi

if [ "$1" = "create" ] && [ -n "${ZFSM_TEST_CREATE_FAIL:-}" ] && [ "$last_arg" = "$ZFSM_TEST_CREATE_FAIL" ]; then
	printf "cannot create '%s': dataset already exists\n" "$last_arg" >&2
	exit 1
fi
# The new dataset mounting where the moved directory was.
[ "$1" = "create" ] && [ -n "${ZFSM_TEST_CREATE_MOUNTS_AT:-}" ] && mkdir -p "$ZFSM_TEST_CREATE_MOUNTS_AT"
exit 0
