#!/bin/sh

if [ "$1" = "list" ]; then
	if [ "${ZFSM_TEST_POOL_FAIL:-0}" = 1 ]; then
		printf 'simulated pool query failure\n' >&2
		exit 1
	fi
	printf 'tank\t1.00T\t100G\t900G\tONLINE\n'
	exit 0
fi

# Block cloning for pool tank: ZFSM_TEST_BCLONE=active|enabled|disabled; unset fails as OpenZFS 2.1 does.
if [ "$1" = "get" ] && [ "$5" = "feature@block_cloning" ] && [ "$6" = "tank" ]; then
	[ -n "${ZFSM_TEST_BCLONE:-}" ] || { printf "bad property list: invalid property 'feature@block_cloning'\n" >&2; exit 1; }
	printf '%s\n' "$ZFSM_TEST_BCLONE"
	exit 0
fi

# zfs rewrite -P needs this: ZFSM_TEST_PHYSICAL=enabled|active|disabled; unset fails as OpenZFS before 2.4 does.
if [ "$1" = "get" ] && [ "$5" = "feature@physical_rewrite" ]; then
	[ -n "${ZFSM_TEST_PHYSICAL:-}" ] || { printf "bad property list: invalid property 'feature@physical_rewrite'\n" >&2; exit 1; }
	printf '%s\n' "$ZFSM_TEST_PHYSICAL"
	exit 0
fi

if [ "$1" = "status" ]; then
	[ "${ZFSM_TEST_ZPOOL_STATUS_FAIL:-0}" = 1 ] && { printf 'simulated zpool status failure\n' >&2; exit 1; }
	[ "${ZFSM_TEST_ZPOOL_STATUS_SLOW:-0}" = 1 ] && { sleep 5; exit 0; }
	[ -n "${ZFSM_TEST_ZPOOL_STATUS:-}" ] && { cat "$ZFSM_TEST_ZPOOL_STATUS"; exit 0; }
	cat <<'EOF'
  pool: tank
 state: ONLINE
config:

	NAME        STATE     READ WRITE CKSUM
	tank        ONLINE       0     0     0
	  mirror-0  ONLINE       0     0     0
	    sda     ONLINE       0     0     0
	    sdb     ONLINE       0     0     0

errors: No known data errors
EOF
	exit 0
fi

exit 1
