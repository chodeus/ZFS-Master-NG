#!/bin/sh
# Unraid's notify script, faked: logs "<importance>: <subject>" per notification.
[ -n "${ZFSM_TEST_NOTIFY_LOG:-}" ] || exit 0
# A notify script that fails, as when Unraid can't write the notification.
[ "${ZFSM_TEST_NOTIFY_FAIL:-0}" = 1 ] && exit 1
subject=''
description=''
importance=''
while [ $# -gt 0 ]; do
	case "$1" in
		-s) subject=$2; shift ;;
		-d) description=$2; shift ;;
		-i) importance=$2; shift ;;
	esac
	shift
done
printf '%s: %s\n' "$importance" "$subject" >> "$ZFSM_TEST_NOTIFY_LOG"
if [ -n "${ZFSM_TEST_NOTIFY_DETAIL_LOG:-}" ]; then printf '%s: %s\n' "$importance" "$description" >> "$ZFSM_TEST_NOTIFY_DETAIL_LOG"; fi
